{
  "name": "dsh-a2ui",
  "version": "0.1.0-alpha.2",
  "private": true,
  "type": "module",
  "description": "A strict, replayable A2UI protocol bridge for DeepSeek Harness.",
  "license": "MIT",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "vite build",
    "dev": "vite --host 127.0.0.1",
    "build:plugin": "vite build --config vite.plugin.config.ts && vite build --config vite.client.config.ts",
    "test:browser": "playwright test",
    "test:packed": "node scripts/verify-packed.mjs"
  },
  "dependencies": {
    "@a2ui/markdown-it": "0.2.2",
    "@a2ui/react": "0.14.0",
    "@a2ui/web_core": "0.14.0",
    "ajv": "8.17.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-api-session-controller": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-chat": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@playwright/test": "1.56.1",
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.10.0",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "6.1.0",
    "vitest": "3.2.4",
    "@deepseek-ai/dsh-app-boot": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.0-rc.2"
  },
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "vendor"
  ],
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-chat": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2 <0.3.0"
  }
}
